# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server
DATABASE_URL="postgresql://opencut:opencut@localhost:5432/opencut"
BETTER_AUTH_SECRET=your_better_auth_secret

REDIS_URL=redis://localhost:6379



# AI providers
# optional: it only acts as a fallback for deployments that predate the panel.

# 32 bytes of hex. Encrypts provider keys stored in the database.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODEL_CREDENTIALS_KEY=your_64_hex_chars_here

# Postgres connection pool per app instance (postgres.js `max`).
# instance_count × pool must stay under the server's max_connections (default 100).
PGPOOL_MAX=10
