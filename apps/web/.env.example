# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Server
DATABASE_URL="postgresql://opencut:opencut@localhost:5432/opencut"
BETTER_AUTH_SECRET=your_better_auth_secret

REDIS_URL=redis://localhost:6379

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# AI providers
# Provider keys are managed in the admin panel (/admin/models). ARK_API_KEY is
# optional: it only acts as a fallback for deployments that predate the panel.
ARK_API_KEY=your_ark_key_here

# 32 bytes of hex. Encrypts provider keys stored in the database.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODEL_CREDENTIALS_KEY=your_64_hex_chars_here
